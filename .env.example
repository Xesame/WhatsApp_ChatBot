# Generated by `pnpm run docs`. Do not edit by hand.
# Copy to .env and change every secret value.

# Runtime mode. Use `production` on the server.
# Optional, default: development. Used by: all services.
NODE_ENV=development

# Minimum level written to the JSON logs (pino).
# Optional, default: info. Used by: all services.
LOG_LEVEL=info

# Postgres connection string used by every service. Docker Compose overrides the host to `postgres` inside the containers.
# Required. Used by: all services.
DATABASE_URL=postgres://reb:change-me@localhost:5432/reb

# Port for the `/health` endpoint of capture, worker and chatbot. Docker health checks call it.
# Optional, default: 8080. Used by: capture, worker, chatbot.
HEALTH_PORT=8080

# Interface the API listens on. `0.0.0.0` accepts connections from other containers.
# Optional, default: 0.0.0.0. Used by: api.
API_HOST=0.0.0.0

# Port the API listens on. The API serves `/health` on this same port.
# Optional, default: 3000. Used by: api.
API_PORT=3000

# Database user created by the Postgres container on first start.
# Optional, default: reb. Used by: docker-compose.yml.
POSTGRES_USER=reb

# Password for POSTGRES_USER. Must match the password inside DATABASE_URL. Only read the first time the database volume is created.
# Required. Used by: docker-compose.yml.
POSTGRES_PASSWORD=change-me

# Database name created by the Postgres container on first start.
# Optional, default: reb. Used by: docker-compose.yml.
POSTGRES_DB=reb
